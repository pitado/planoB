@startuml
skinparam classAttributeIconSize 0

abstract class Ocorrencia {
  - id: Long
  - tipo: TipoOcorrencia
  - localizacao: Localizacao
  - descricao: String
  - severidade: int
  - status: StatusOcorrencia
  + calcularIndiceImpacto(): int
  + prioridade(): Prioridade
  + explicarIndiceImpacto(): String
  # pesoOperacional(): int
}
class FalhaEnergia
class ViaObstruida
class Alagamento
class DanoEstrutural
class Localizacao
enum StatusOcorrencia
class PoliticaTransicaoStatus {
  + permite(atual, destino): boolean
  + exigirTransicaoValida(atual, destino): void
}
class OcorrenciaFactory {
  + nova(tipo, localizacao, descricao, severidade): Ocorrencia
  + reconstituir(...): Ocorrencia
}
class OcorrenciaService {
  + cadastrar(...): long
  + consultar(id): Ocorrencia
  + atualizar(...): void
  + excluir(id): void
}
interface OcorrenciaRepository {
  + criar(ocorrencia): long
  + buscar(id): Optional
  + listar(status, tipo): List
  + atualizar(ocorrencia): boolean
  + excluir(id): boolean
}
interface AcaoRepository
class AcaoRecuperacao

Ocorrencia <|-- FalhaEnergia
Ocorrencia <|-- ViaObstruida
Ocorrencia <|-- Alagamento
Ocorrencia <|-- DanoEstrutural
Ocorrencia "1" *-- "1" Localizacao
Ocorrencia "1" *-- "0..*" AcaoRecuperacao : organiza
OcorrenciaService --> OcorrenciaRepository : utiliza
OcorrenciaService ..> PoliticaTransicaoStatus : valida
OcorrenciaFactory ..> Ocorrencia : constroi
PoliticaTransicaoStatus ..> StatusOcorrencia

note bottom of Ocorrencia
pesoOperacional() é sobrescrito com @Override
em cada subtipo (polimorfismo).
Índice é meramente demonstrativo.
end note

note right of OcorrenciaRepository
A implementação PostgreSQL é responsabilidade
da Sprint 3 (Gustavo).
end note

note right of OcorrenciaService
A interface HTTP é responsabilidade
da Sprint 2 (Lucas).
end note
@enduml
